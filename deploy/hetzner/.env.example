# Adresse der App – ein DNS-A-Eintrag dieser (Sub-)Domain muss auf die IPv4 des Servers zeigen
DOMAIN=altinger-demo.example.de
# E-Mail für Let's Encrypt (Hinweise zu ablaufenden Zertifikaten)
ACME_EMAIL=info@example.de

# Demo-Modus: Ein-Klick-Anmeldung, QR-Codes auf /demo, Zurücksetzen für alle (für Pilotbetrieb: false)
DEMO_MODE=true
# Demo-Daten jeden Morgen frisch erzeugen (für Pilotbetrieb: false)
RESEED_STALE=true
