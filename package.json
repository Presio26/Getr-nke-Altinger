{
  "name": "getraenke-altinger-app",
  "private": true,
  "version": "0.1.0",
  "description": "Getränke Altinger – Bestell-, Liefer- und Markt-App (PWA) für B2C & B2B",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "reset-data": "rm -f data/db.json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "clsx": "2.1.1",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "express": "4.22.3",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "0.577.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.18.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.4",
    "workbox-window": "7.3.0"
  }
}
